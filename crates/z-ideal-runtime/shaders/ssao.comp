#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D scene_depth;
layout(set = 0, binding = 1, r32f) writeonly uniform image2D ambient_occlusion_output;

layout(set = 0, binding = 2, std140) uniform SsaoData {
    mat4 inverse_projection;
    vec4 sample_parameters; // radius_pixels, radius_world, depth_bias, intensity
    uvec4 extent;            // width, height, reserved, reserved
} ssao;

const vec2 SAMPLE_DIRECTIONS[8] = vec2[](
    vec2(1.0, 0.0), vec2(-1.0, 0.0),
    vec2(0.0, 1.0), vec2(0.0, -1.0),
    vec2(0.70710678, 0.70710678), vec2(-0.70710678, 0.70710678),
    vec2(0.70710678, -0.70710678), vec2(-0.70710678, -0.70710678)
);

vec3 reconstruct_view_position(ivec2 pixel, float depth) {
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(ssao.extent.xy);
    vec4 clip_position = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 view_position = ssao.inverse_projection * clip_position;
    return view_position.xyz / view_position.w;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dimensions = ivec2(ssao.extent.xy);
    if (any(greaterThanEqual(pixel, dimensions))) {
        return;
    }

    float center_depth = texelFetch(scene_depth, pixel, 0).r;
    if (center_depth >= 1.0) {
        imageStore(ambient_occlusion_output, pixel, vec4(1.0));
        return;
    }

    vec3 center = reconstruct_view_position(pixel, center_depth);
    ivec2 right_pixel = min(pixel + ivec2(1, 0), dimensions - 1);
    ivec2 left_pixel = max(pixel - ivec2(1, 0), ivec2(0));
    ivec2 down_pixel = min(pixel + ivec2(0, 1), dimensions - 1);
    ivec2 up_pixel = max(pixel - ivec2(0, 1), ivec2(0));
    vec3 right_position = reconstruct_view_position(
        right_pixel, texelFetch(scene_depth, right_pixel, 0).r);
    vec3 left_position = reconstruct_view_position(
        left_pixel, texelFetch(scene_depth, left_pixel, 0).r);
    vec3 down_position = reconstruct_view_position(
        down_pixel, texelFetch(scene_depth, down_pixel, 0).r);
    vec3 up_position = reconstruct_view_position(
        up_pixel, texelFetch(scene_depth, up_pixel, 0).r);
    vec3 normal_cross = cross(right_position - left_position, down_position - up_position);
    if (dot(normal_cross, normal_cross) <= 1e-12) {
        imageStore(ambient_occlusion_output, pixel, vec4(1.0));
        return;
    }
    vec3 normal = normalize(normal_cross);
    if (normal.z < 0.0) {
        normal = -normal;
    }

    float radius_pixels = ssao.sample_parameters.x;
    float radius_world = ssao.sample_parameters.y;
    float depth_bias = ssao.sample_parameters.z;
    float intensity = ssao.sample_parameters.w;
    float occlusion = 0.0;
    for (int index = 0; index < 8; ++index) {
        ivec2 offset = ivec2(round(SAMPLE_DIRECTIONS[index] * radius_pixels));
        ivec2 sample_pixel = pixel + offset;
        if (any(lessThan(sample_pixel, ivec2(0)))
            || any(greaterThanEqual(sample_pixel, dimensions))) {
            continue;
        }
        float sample_depth = texelFetch(scene_depth, sample_pixel, 0).r;
        if (sample_depth >= 1.0) {
            continue;
        }
        vec3 sample_position = reconstruct_view_position(sample_pixel, sample_depth);
        vec3 delta = sample_position - center;
        float distance_to_sample = length(delta);
        if (distance_to_sample <= 1e-5 || distance_to_sample >= radius_world
            || sample_position.z <= center.z + depth_bias) {
            continue;
        }
        float facing = max(dot(normal, delta / distance_to_sample), 0.0);
        float range_weight = 1.0 - distance_to_sample / radius_world;
        occlusion += facing * range_weight;
    }

    float ao = clamp(1.0 - (occlusion / 8.0) * intensity, 0.0, 1.0);
    imageStore(ambient_occlusion_output, pixel, vec4(ao));
}
